<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/headerDark" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/header"
                android:endColor="@color/accent" />
            <stroke android:width="2dp" android:color="@color/headerText" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
