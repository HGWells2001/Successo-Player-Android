<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUCCESSO PLAYER"
                android:textColor="@color/headerText"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/programSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storie e voci dal Novecento · RaiPlay Sound"
                android:textColor="@color/headerText"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/refreshButton"
            style="@style/HeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_bg"
        android:hint="Cerca titolo, data o descrizione"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textHint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/countText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Catalogo"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/favoritesFilterButton"
            style="@style/AccentButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="☆ Tutte"
            android:textSize="11sp" />

        <Button
            android:id="@+id/unlistenedFilterButton"
            style="@style/ControlButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="○ Non ascoltate"
            android:textSize="11sp"
            android:contentDescription="Mostra solo le puntate non ancora ascoltate" />
    </LinearLayout>

    <ListView
        android:id="@+id/episodeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_bg"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:listSelector="@color/listSelector" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/selectedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleziona una puntata"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/selectedMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent"
            android:progressBackgroundTint="@color/progressTrack"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/previousButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏮" />

                <Button
                    android:id="@+id/rewindButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="−30" />

                <Button
                    android:id="@+id/playButton"
                    style="@style/AccentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="▶" />

                <Button
                    android:id="@+id/forwardButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="+30" />

                <Button
                    android:id="@+id/nextButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="⏭" />

                <Button
                    android:id="@+id/shuffleButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="🔀"
                    android:contentDescription="Attiva riproduzione casuale" />

                <Spinner
                    android:id="@+id/speedSpinner"
                    android:layout_width="110dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:progressTint="@color/header"
                android:thumbTint="@color/header"
                android:progressBackgroundTint="@color/progressTrack"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="85" />

            <TextView
                android:id="@+id/volumeText"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="85%"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/downloadButton"
                style="@style/AccentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scarica puntata" />

            <Button
                android:id="@+id/openRaiButton"
                style="@style/ControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="7dp"
                android:text="Apri su RaiPlay" />
        </LinearLayout>

        <TextView
            android:id="@+id/downloadProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Download 0%"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminateTint="@color/header"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Pronto"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
