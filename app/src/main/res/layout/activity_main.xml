<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="2dp">

        <View
            android:layout_width="3dp"
            android:layout_height="36dp"
            android:layout_marginRight="11dp"
            android:background="@color/brandAccent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUCCESSO PLAYER"
                android:textColor="@color/headerText"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/programSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storie e voci dal Novecento"
                android:textColor="@color/miniTextMuted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/moreMenuButton"
            style="@style/HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="6dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:gravity="center"
            android:text="⋮"
            android:textAllCaps="false"
            android:textSize="26sp"
            android:contentDescription="Apri menu: ricerca, coda, timer, cronologia e aggiornamenti" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Cerca titolo, parola, data…"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:inputType="text"
            android:background="@android:color/transparent"
            android:paddingLeft="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:maxLength="100"
            android:textSize="14sp"
            android:contentDescription="Cerca nel catalogo delle puntate" />

        <Button
            android:id="@+id/clearSearchButton"
            style="@style/ControlButton"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="19sp"
            android:contentDescription="Cancella ricerca"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/updateDownloadHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="5dp"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/countText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Catalogo"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/favoritesFilterButton"
            style="@style/ControlButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="☆ Tutte"
            android:textSize="11sp" />

        <Button
            android:id="@+id/unlistenedFilterButton"
            style="@style/ControlButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="○ Non ascoltate"
            android:textSize="11sp"
            android:contentDescription="Mostra solo le puntate non ancora ascoltate" />
    </LinearLayout>

    <ListView
        android:id="@+id/episodeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipToPadding="false"
        android:cacheColorHint="@android:color/transparent"
        android:contentDescription="Catalogo puntate, tieni premuto per la coda"
        android:listSelector="@color/listSelector" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/playbackDetailsPanel"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/selectedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleziona una puntata"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/selectedMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent"
            android:progressBackgroundTint="@color/progressTrack"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/previousButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏮" />

                <Button
                    android:id="@+id/rewindButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="−30" />

                <Button
                    android:id="@+id/playButton"
                    style="@style/AccentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="▶" />

                <Button
                    android:id="@+id/forwardButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="+30" />

                <Button
                    android:id="@+id/nextButton"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="⏭" />

                <ImageButton
                    android:id="@+id/shuffleButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="5dp"
                    android:background="@drawable/button_bg"
                    android:src="@drawable/ic_shuffle_art"
                    android:tint="@color/textPrimary"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    android:contentDescription="Attiva riproduzione casuale" />

            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:progressTint="@color/header"
                android:thumbTint="@color/header"
                android:progressBackgroundTint="@color/progressTrack"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="85" />

            <TextView
                android:id="@+id/volumeText"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="85%"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/downloadButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/accent_button_bg"
                android:src="@drawable/ic_download_art"
                android:tint="@color/onAccent"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:contentDescription="Scarica puntata selezionata" />

            <ImageButton
                android:id="@+id/openDownloadsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/button_bg"
                android:src="@drawable/ic_library_art"
                android:tint="@color/textPrimary"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:layout_marginLeft="7dp"
                android:contentDescription="Apri la libreria delle puntate scaricate" />

            <ToggleButton
                android:id="@+id/liveAutoSwitch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:background="@drawable/live_toggle_bg"
                android:textColor="@color/live_toggle_text"
                android:textOn="● Diretta programma"
                android:textOff="○ Diretta programma"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:contentDescription="Diretta programma: orario, conto alla rovescia e stato connessione" />
        </LinearLayout>

        <TextView
            android:id="@+id/downloadProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Download 0%"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminateTint="@color/header"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Pronto"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>
    <!-- Permanent compact player beneath the episode list and optional details. -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/mini_player_bg"
        android:orientation="vertical"
        android:elevation="3dp"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/miniArtwork"
                android:layout_width="30dp"
                android:layout_height="34dp"
                android:layout_marginRight="7dp"
                android:gravity="center"
                android:background="@drawable/mini_art_bg"
                android:text="♫"
                android:textColor="@color/brandAccent"
                android:textSize="19sp"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingRight="5dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleziona una puntata"
                    android:textColor="@color/headerText"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <TextView
                    android:id="@+id/miniSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pronto per l'ascolto"
                    android:textColor="@color/miniTextMuted"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
            <Button
                android:id="@+id/miniPlayButton"
                style="@style/MiniPlayButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:padding="0dp"
                android:text="▶"
                android:textSize="19sp"
                android:contentDescription="Riproduci o metti in pausa"/>
            <Button
                android:id="@+id/miniNextButton"
                style="@style/HeaderButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:padding="0dp"
                android:text="⏭"
                android:textSize="18sp"
                android:contentDescription="Puntata successiva"/>
            <Button
                android:id="@+id/miniExpandButton"
                style="@style/HeaderButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:padding="0dp"
                android:text="⌃"
                android:textSize="22sp"
                android:contentDescription="Espandi controlli completi"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="@color/brandAccent"
            android:progressBackgroundTint="@color/miniProgressTrack"/>
    </LinearLayout>
</LinearLayout>
